{% extends "base.html" %}
{% block title %}Dashboard - ShowWise Backend{% endblock %}
{% block content %}
<div class="page-header">
  <h1><i class="fas fa-chart-line"></i> Instance Management Dashboard</h1>
  <p>Welcome back, {{ username }}! Comprehensive overview of your ShowWise deployment.</p>
</div>

<!-- Stats Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
  <div class="card" style="border-left: 4px solid var(--primary);">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="width:60px;height:60px;background:linear-gradient(135deg,var(--primary) 0%,var(--accent) 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:white;">
        <i class="fas fa-building"></i>
      </div>
      <div>
        <div style="font-size:0.85rem;color:var(--gray-600);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Total Instances</div>
        <div style="font-size:2rem;font-weight:900;color:var(--dark);line-height:1;">{{ stats.total_organizations }}</div>
      </div>
    </div>
  </div>

  <div class="card" style="border-left: 4px solid var(--success);">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="width:60px;height:60px;background:var(--success);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:white;">
        <i class="fas fa-check-circle"></i>
      </div>
      <div>
        <div style="font-size:0.85rem;color:var(--gray-600);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Active</div>
        <div style="font-size:2rem;font-weight:900;color:var(--dark);line-height:1;">{{ stats.active_organizations }}</div>
      </div>
    </div>
  </div>

  <div class="card" style="border-left: 4px solid var(--warning);">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="width:60px;height:60px;background:var(--warning);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:white;">
        <i class="fas fa-pause-circle"></i>
      </div>
      <div>
        <div style="font-size:0.85rem;color:var(--gray-600);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Inactive</div>
        <div style="font-size:2rem;font-weight:900;color:var(--dark);line-height:1;">{{ stats.inactive_organizations }}</div>
      </div>
    </div>
  </div>

  <div class="card" style="border-left: 4px solid var(--accent);">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div style="width:60px;height:60px;background:var(--accent);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.75rem;color:white;">
        <i class="fas fa-plug"></i>
      </div>
      <div>
        <div style="font-size:0.85rem;color:var(--gray-600);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">API Status</div>
        <div style="font-size:1.5rem;font-weight:900;color:var(--dark);line-height:1;">{{ stats.api_status }}</div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
  <div class="card">
    <div class="card-header">
      <h2><i class="fas fa-rocket"></i> Quick Actions</h2>
      <p>Common tasks and shortcuts</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <a href="{{ url_for('add_organization') }}" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Instance
      </a>
      <a href="{{ url_for('organizations_list') }}" class="btn btn-secondary">
        <i class="fas fa-building"></i> View All Instances
      </a>
      <a href="{{ url_for('logs_list') }}" class="btn btn-secondary">
        <i class="fas fa-clipboard-list"></i> View Logs
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2><i class="fas fa-chart-area"></i> Instance Monitoring</h2>
      <p>Track health and performance</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <a href="{{ url_for('uptime_dashboard') }}" class="btn btn-secondary">
        <i class="fas fa-heartbeat"></i> Uptime Dashboard
      </a>
      <a href="{{ url_for('api_keys_list') }}" class="btn btn-secondary">
        <i class="fas fa-key"></i> API Keys
      </a>
      <a href="{{ url_for('kill_switches_list') }}" class="btn btn-secondary">
        <i class="fas fa-power-off"></i> Kill Switches
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2><i class="fas fa-comments"></i> Support</h2>
      <p>Customer communications</p>
    </div>
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <a href="{{ url_for('chat_dashboard') }}" class="btn btn-secondary">
        <i class="fas fa-comment-dots"></i> Live Chat
      </a>
      <a href="{{ url_for('settings') }}" class="btn btn-secondary">
        <i class="fas fa-cog"></i> Settings
      </a>
    </div>
  </div>
</div>

<!-- API Endpoints Reference -->
<div class="card">
  <div class="card-header">
    <h2><i class="fas fa-code"></i> API Endpoints</h2>
    <p>Instance integration endpoints</p>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; font-size: 0.9rem; color: var(--gray-700);">
    <div style="padding:0.75rem;background:var(--gray-50);border-radius:6px;font-family:monospace;"><strong>GET</strong> /api/organizations</div>
    <div style="padding:0.75rem;background:var(--gray-50);border-radius:6px;font-family:monospace;"><strong>POST</strong> /api/uptime/ping</div>
    <div style="padding:0.75rem;background:var(--gray-50);border-radius:6px;font-family:monospace;"><strong>GET</strong> /api/kill-switch/{slug}</div>
    <div style="padding:0.75rem;background:var(--gray-50);border-radius:6px;font-family:monospace;"><strong>POST</strong> /api/chat/send</div>
    <div style="padding:0.75rem;background:var(--gray-50);border-radius:6px;font-family:monospace;"><strong>POST</strong> /api/log</div>
    <div style="padding:0.75rem;background:var(--gray-50);border-radius:6px;font-family:monospace;"><strong>GET</strong> /api/health</div>
  </div>
</div>
{% endblock %}