app.config['GITHUB_CLIENT_SECRET'] = os.getenv('GITHUB_CLIENT_SECRET')

# Security: CSRF Protection
csrf = CSRFProtect(app)

# Security: Rate Limiting
limiter = Limiter(
    app=app,
    key_func=get_remote_address,
    default_limits=["200 per day", "50 per hour"],
    storage_uri="memory://"
)

# Logger
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# ==================== ANTI-BURP SUITE PROTECTION ====================

BURPSUITE_INDICATORS = {
    'user_agents': [
        r'burpsuite',
        r'owasp.*zap',
        r'sqlmap',
        r'nikto',
        r'acunetix',
        r'nessus',
        r'masscan',
        r'nmap',
        r'metasploit',
    ],
    'header_keys': [
        'x-scanner',
        'x-burp',
        'x-zap',
    ],
}

def detect_burp_suite():
    """Detect if request is from BurpSuite or security scanner."""
    user_agent = (request.headers.get('User-Agent') or '').lower()
    
    # Check user agent patterns
    for pattern in BURPSUITE_INDICATORS['user_agents']:
        if re.search(pattern, user_agent, re.IGNORECASE):
            return True
    
    # Check suspicious headers
    for header_key in BURPSUITE_INDICATORS['header_keys']:
        if request.headers.get(header_key):
            return True
    
    return False

def get_client_ip_with_cf():
    """Extract client IP respecting Cloudflare headers."""
    if request.headers.get('CF-Connecting-IP'):
        return request.headers.get('CF-Connecting-IP')
    if request.headers.get('X-Forwarded-For'):
        return request.headers.get('X-Forwarded-For').split(',')[0].strip()
    return request.remote_addr or '0.0.0.0'

@app.before_request
def security_checks():
    """Before request security checks."""
    g.client_ip = get_client_ip_with_cf()
    g.user_agent = request.headers.get('User-Agent', '')
    
    # Detect BurpSuite
    if detect_burp_suite():
        logger.warning(f"[SECURITY] BurpSuite/Scanner detected from IP: {g.client_ip}")
        # Optionally log to shared security DB
        try:
            from api_integration import log_security_event_to_shared_db
            log_security_event_to_shared_db(
                'burpsuite_detected',
                g.client_ip,
                'high',
                f'BurpSuite or security scanner detected trying to access backend',
                app_instance=os.getenv('APP_INSTANCE_NAME', 'backend')
            )
        except:
            pass
        return jsonify({'error': 'Automated tools are not permitted'}), 403

# Enable CORS for API endpoints
CORS(app, resources={
    r"/api/*": {
        "origins": os.getenv('CORS_ORIGINS', '*').split(','),
        "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "allow_headers": ["Content-Type", "Authorization"],
        "expose_headers": ["Content-Type"],
        "max_age": 3600
    }
})

